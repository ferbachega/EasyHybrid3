                      <object class="GtkMenuItem" id="menuitem_system_force_field">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="label" translatable="yes">Force Field</property>
                        <property name="use-underline">True</property>
                        <child type="submenu">
                          <object class="GtkMenu">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <child>
                              <object class="GtkMenuItem" id="menuitem_opls_parameters">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="tooltip-text" translatable="yes">Inspect the force-field parameters of the active system (OPLS, AMBER, CHARMM or DYFF): charges, bonds, angles, dihedrals, impropers and Lennard-Jones, each shown where it is used in the structure. Systems prepared with Prepare OPLS System can also be edited here.</property>
                                <property name="label" translatable="yes">Force Field Parameters...</property>
                                <property name="use-underline">True</property>
                                <signal name="activate" handler="on_main_menu_activate" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkMenuItem" id="menuitem_parametrization_report">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="tooltip-text" translatable="yes">Data and plots of a DYFF modified parametrization of ligands: charges (CM5, RESP), Hessian bonds and angles, library and fitted torsions with the xTB scan profiles, and the original xTB / ORCA logs.</property>
                                <property name="label" translatable="yes">Parametrization Report...</property>
                                <property name="use-underline">True</property>
                                <signal name="activate" handler="on_main_menu_activate" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkMenuItem" id="menuitem_define_force_field">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="label" translatable="yes">Define Force Field</property>
                                <property name="use-underline">True</property>
                                <child type="submenu">
                                  <object class="GtkMenu">
                                    <property name="visible">True</property>
                                    <property name="can-focus">False</property>
                                    <child>
                                      <object class="GtkMenuItem" id="menuitem_prepare_opls_system">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="tooltip-text" translatable="yes">Builds an OPLS-AA system from the loaded structure: hydrogens, termini, disulfides, protonation states, ligand parametrization (CM5 charges) and, optionally, solvation.</property>
                                        <property name="label" translatable="yes">Prepare OPLS System...</property>
                                        <property name="use-underline">True</property>
                                        <signal name="activate" handler="on_main_menu_activate" swapped="no"/>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkMenuItem" id="menuitem_prepare_dyff_system">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="tooltip-text" translatable="yes">Assigns DYFF to the active system. Choose the version: DYFF modified (residue library, Seminario bonds/angles from xTB Hessians, CM5 charges), DYFF 1.0-EH (generic rules, EasyHybrid atom types) or pDynamo's original DYFF 1.0. A raw structure is prepared first (hydrogens, protonation, metal sites).</property>
                                        <property name="label" translatable="yes">Prepare DYFF System...</property>
                                        <property name="use-underline">True</property>
                                        <signal name="activate" handler="on_main_menu_activate" swapped="no"/>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkMenuItem" id="menuitem_load_dyff_parametrization">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="tooltip-text" translatable="yes">Applies a saved DYFF modified parametrization (the dyff_param_... folder written by Prepare DYFF System: parametrization.json, report.html and the xTB/ORCA logs) to the active system, without computing it again. The system must have the same atoms and bonds.</property>
                                        <property name="label" translatable="yes">Load DYFF Parametrization...</property>
                                        <property name="use-underline">True</property>
                                        <signal name="activate" handler="on_main_menu_activate" swapped="no"/>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSeparatorMenuItem">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkMenuItem" id="menuitem_remove_force_field">
                                <property name="visible">True</property>
                                <property name="can-focus">False</property>
                                <property name="tooltip-text" translatable="yes">Removes the MM model (and the nonbonded model) of the active system. Atoms, bonds and coordinates are kept.</property>
                                <property name="label" translatable="yes">Remove Force Field</property>
                                <property name="use-underline">True</property>
                                <signal name="activate" handler="on_main_menu_activate" swapped="no"/>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
