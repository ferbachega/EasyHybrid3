<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated with glade 3.38.2 -->
<!-- "Run AutoDock Vina" window: ports ~/programs/adtVinaFR (a standalone
     script that cross-docks a folder of receptor PDBQTs against a
     folder of ligand PDBQTs) into EasyHybrid, adding loaded-object
     input (export N frames of a System/Object as a PDB ensemble,
     matching the folder-of-PDBs case the original script always
     expected) alongside plain folder browsing. See util/vina_runner.py
     for the actual OpenBabel/Vina wrapping (GTK-free, independently
     testable) and prepare_vina_docking.py for this window's logic. -->
<interface>
  <requires lib="gtk+" version="3.24"/>

  <!-- ==================== Receptor source combo ==================== -->
  <object class="GtkListStore" id="liststore_receptor_source">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0">file</col>
        <col id="1" translatable="yes">Single PDB file</col>
      </row>
      <row>
        <col id="0">folder</col>
        <col id="1" translatable="yes">Folder of PDB files (ensemble)</col>
      </row>
      <row>
        <col id="0">vobject</col>
        <col id="1" translatable="yes">Loaded object (EasyHybrid)</col>
      </row>
    </data>
  </object>
  <object class="GtkListStore" id="liststore_ligand_source">
    <columns>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
    <data>
      <row>
        <col id="0">folder</col>
        <col id="1" translatable="yes">Folder of PDB files</col>
      </row>
      <row>
        <col id="0">vobject</col>
        <col id="1" translatable="yes">Loaded object (EasyHybrid)</col>
      </row>
    </data>
  </object>

  <object class="GtkListStore" id="liststore_ligand_list">
    <columns>
      <column type="gchararray"/> <!-- 0: display name (basename) -->
      <column type="gchararray"/> <!-- 1: full path -->
    </columns>
  </object>

  <object class="GtkListStore" id="liststore_results">
    <columns>
      <column type="gchararray"/> <!-- 0: receptor -->
      <column type="gchararray"/> <!-- 1: ligand -->
      <column type="gint"/>       <!-- 2: mode -->
      <column type="gdouble"/>    <!-- 3: affinity -->
      <column type="gdouble"/>    <!-- 4: rmsd_lb -->
      <column type="gdouble"/>    <!-- 5: rmsd_ub -->
      <column type="gint"/>       <!-- 6: vobject_id once this row's ligand has been imported, else -1 -->
      <column type="gint"/>       <!-- 7: frame_index within that vobject, else -1 -->
      <column type="gint"/>       <!-- 8: receptor_vobject_id, if the receptor was also loaded into VisMol, else -1 -->
      <column type="gint"/>       <!-- 9: receptor_frame_index within that receptor vobject, else -1 -->
    </columns>
  </object>

  <object class="GtkAdjustment" id="adjustment_receptor_frame_init">
    <property name="upper">999999</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_receptor_frame_last">
    <property name="lower">-1</property>
    <property name="upper">999999</property>
    <property name="value">-1</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_receptor_step">
    <property name="lower">1</property>
    <property name="upper">999999</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_receptor_goto_frame">
    <property name="lower">0</property>
    <property name="upper">999999</property>
    <property name="value">0</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_ligand_frame_init">
    <property name="upper">999999</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_ligand_frame_last">
    <property name="lower">-1</property>
    <property name="upper">999999</property>
    <property name="value">-1</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_ligand_step">
    <property name="lower">1</property>
    <property name="upper">999999</property>
    <property name="value">1</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_ligand_ph">
    <property name="lower">0</property>
    <property name="upper">14</property>
    <property name="value">7.4</property>
    <property name="step-increment">0.1</property>
  </object>

  <!-- . Each spinbutton below gets its OWN adjustment: three
       independent GtkSpinButtons sharing a single GtkAdjustment would
       all mirror whichever one was set last (a GtkAdjustment is the
       shared VALUE, not just a set of bounds), silently collapsing
       Center X/Y/Z (or Size X/Y/Z) into one number. Confirmed live: a
       single shared adjustment_center_xyz made every "Grid center"
       axis in Vina's own log equal the last one set. -->
  <object class="GtkAdjustment" id="adjustment_center_x">
    <property name="lower">-9999</property>
    <property name="upper">9999</property>
    <property name="step-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_center_y">
    <property name="lower">-9999</property>
    <property name="upper">9999</property>
    <property name="step-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_center_z">
    <property name="lower">-9999</property>
    <property name="upper">9999</property>
    <property name="step-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_size_x">
    <property name="lower">1</property>
    <property name="upper">300</property>
    <property name="value">20</property>
    <property name="step-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_size_y">
    <property name="lower">1</property>
    <property name="upper">300</property>
    <property name="value">20</property>
    <property name="step-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_size_z">
    <property name="lower">1</property>
    <property name="upper">300</property>
    <property name="value">20</property>
    <property name="step-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_box_padding">
    <property name="lower">0</property>
    <property name="upper">50</property>
    <property name="value">5</property>
    <property name="step-increment">0.5</property>
  </object>

  <object class="GtkAdjustment" id="adjustment_exhaustiveness">
    <property name="lower">1</property>
    <property name="upper">1000</property>
    <property name="value">8</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_num_modes">
    <property name="lower">1</property>
    <property name="upper">100</property>
    <property name="value">9</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_energy_range">
    <property name="lower">0.1</property>
    <property name="upper">20</property>
    <property name="value">3</property>
    <property name="step-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_cpu">
    <property name="lower">1</property>
    <property name="upper">256</property>
    <property name="value">4</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_seed">
    <property name="lower">0</property>
    <property name="upper">2147483647</property>
    <property name="step-increment">1</property>
  </object>

