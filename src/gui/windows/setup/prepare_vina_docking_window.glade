                            <child>
                              <object class="GtkTreeViewColumn" id="col_ligand">
                                <property name="title" translatable="yes">Ligand</property>
                                <property name="sort-column-id">1</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">1</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_mode">
                                <property name="title" translatable="yes">Mode</property>
                                <property name="sort-column-id">2</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">2</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_affinity">
                                <property name="title" translatable="yes">Affinity (kcal/mol)</property>
                                <property name="sort-column-id">3</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">3</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_rmsd_lb">
                                <property name="title" translatable="yes">RMSD l.b.</property>
                                <property name="sort-column-id">4</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">4</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_rmsd_ub">
                                <property name="title" translatable="yes">RMSD u.b.</property>
                                <property name="sort-column-id">5</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">5</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButtonBox">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="spacing">5</property>
                        <property name="layout-style">end</property>
                        <child>
                          <object class="GtkButton" id="button_import_previous_results">
                            <property name="label" translatable="yes">Import previous results...</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                            <property name="tooltip-text" translatable="yes">Points at a previous "..._OUTPUTS" folder generated by this tool (or AutoDock-GPU's own) and adds every row from its affinity_logs.txt to the table below, alongside whatever is already loaded -- no docking is re-run, the existing *_docked.pdbqt/log files there are reused as-is.</property>
                            <signal name="clicked" handler="on_button_import_previous_results_clicked" swapped="no"/>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">0</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_clear_results">
                            <property name="label" translatable="yes">Clear results</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                            <signal name="clicked" handler="on_button_clear_results_clicked" swapped="no"/>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_import_pose">
                            <property name="label" translatable="yes">Import all poses</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                            <property name="tooltip-text" translatable="yes">Imports EVERY pose currently in this table (every mode, ligand and receptor) as ONE object with one frame per pose, ranked best affinity first -- including every conformer of an ensemble-docked ligand, not just the selected row's. Once imported, selecting any row jumps the 3D view to that row's own frame. Every pose is checked against the first one's own atom count AND element order before combining -- a count mismatch stops there (kept frames stay); an order-only mismatch (same atoms, different sequence -- an OpenBabel quirk seen across separately-converted conformer files) skips just that one pose, reported afterward, so the rest still combine correctly.</property>
                            <signal name="clicked" handler="on_button_import_pose_clicked" swapped="no"/>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">2</property>
                          </packing>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Results</property>
              </object>
            </child>

          </object>
        </child>
        <child>
          <object class="GtkButtonBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">5</property>
            <property name="layout-style">end</property>
            <child>
              <object class="GtkButton" id="button_close">
                <property name="label" translatable="yes">Close</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <signal name="clicked" handler="close_window" swapped="no"/>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
