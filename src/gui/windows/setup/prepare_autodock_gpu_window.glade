                                    <property name="can-focus">True</property>
                                    <property name="receives-default">True</property>
                                    <property name="tooltip-text" translatable="yes">Selects atoms in the 3D view first, then click this: only Center above is set, to the plain average (centroid) position of that selection -- Size is left untouched. Different from "Compute from current viewer selection" above, which centres on the MIDPOINT of the selection's bounding box instead -- the two agree only for a symmetric selection; for a lopsided one (e.g. a pocket with residues bulging to one side) the centroid follows where the atoms actually are, while the bounding-box midpoint can be pulled off-centre by a single outlying atom.</property>
                                    <signal name="clicked" handler="on_button_center_on_centroid_clicked" swapped="no"/>
                                  </object>
