                                                <property name="can-focus">False</property>
                                                <property name="halign">start</property>
                                                <property name="label" translatable="yes">Heuristics evals limit (heurmax):</property>
                                                <property name="tooltip-text" translatable="yes">--heurmax: asymptotic ceiling on the number of score evaluations the ligand-based heuristics may pick. AutoDock-GPU's own default is 12000000.</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">2</property>
                                                <property name="top-attach">0</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkSpinButton" id="spinbtn_heurmax">
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <property name="adjustment">adjustment_heurmax</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">3</property>
                                                <property name="top-attach">0</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="halign">start</property>
                                                <property name="label" translatable="yes">Max score evals (nev):</property>
                                                <property name="tooltip-text" translatable="yes">--nev: hard ceiling on score evaluations per GA run. AutoDock-GPU's own default is 2500000.</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">0</property>
                                                <property name="top-attach">1</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkSpinButton" id="spinbtn_nev">
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <property name="adjustment">adjustment_nev</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">1</property>
                                                <property name="top-attach">1</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="halign">start</property>
                                                <property name="label" translatable="yes">Max generations (ngen):</property>
                                                <property name="tooltip-text" translatable="yes">--ngen: hard ceiling on GA generations per run. AutoDock-GPU's own default is 42000.</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">2</property>
                                                <property name="top-attach">1</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkSpinButton" id="spinbtn_ngen">
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <property name="adjustment">adjustment_ngen</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">3</property>
                                                <property name="top-attach">1</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="halign">start</property>
                                                <property name="label" translatable="yes">Max local-search iters (lsit):</property>
                                                <property name="tooltip-text" translatable="yes">--lsit: max. iterations per local-search call. AutoDock-GPU's own default is 300.</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">0</property>
                                                <property name="top-attach">2</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkSpinButton" id="spinbtn_lsit">
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <property name="adjustment">adjustment_lsit</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">1</property>
                                                <property name="top-attach">2</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="visible">True</property>
                                                <property name="can-focus">False</property>
                                                <property name="halign">start</property>
                                                <property name="label" translatable="yes">Population size (psize):</property>
                                                <property name="tooltip-text" translatable="yes">--psize: number of individuals in the GA population. AutoDock-GPU's own default is 150.</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">2</property>
                                                <property name="top-attach">2</property>
                                              </packing>
                                            </child>
                                            <child>
                                              <object class="GtkSpinButton" id="spinbtn_psize">
                                                <property name="visible">True</property>
                                                <property name="can-focus">True</property>
                                                <property name="adjustment">adjustment_psize</property>
                                              </object>
                                              <packing>
                                                <property name="left-attach">3</property>
                                                <property name="top-attach">2</property>
                                              </packing>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child type="label">
                                      <object class="GtkLabel">
                                        <property name="visible">True</property>
                                        <property name="can-focus">False</property>
                                        <property name="label" translatable="yes">Advanced search parameters</property>
                                      </object>
                                    </child>
                                  </object>
                                  <packing>
                                    <property name="left-attach">0</property>
                                    <property name="top-attach">3</property>
                                    <property name="width">4</property>
                                  </packing>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="label">
                          <object class="GtkLabel">
                            <property name="visible">True</property>
                            <property name="can-focus">False</property>
                            <property name="label" translatable="yes">AutoDock-GPU Parameters</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label_docking_status">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="halign">start</property>
                        <property name="wrap">True</property>
                        <property name="label" translatable="yes">Prepare the receptor and ligand first, then click "Run".</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">2</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="vexpand">True</property>
                        <property name="shadow-type">in</property>
                        <child>
                          <object class="GtkTextView" id="textview_log">
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="editable">False</property>
                            <property name="monospace">True</property>
                            <property name="wrap-mode">word-char</property>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">3</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButtonBox">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="spacing">5</property>
                        <property name="layout-style">end</property>
                        <child>
                          <object class="GtkButton" id="button_stop">
                            <property name="label" translatable="yes">Stop</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                            <property name="sensitive">False</property>
                            <signal name="clicked" handler="on_button_stop_clicked" swapped="no"/>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">0</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_run">
                            <property name="label" translatable="yes">Run</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                            <signal name="clicked" handler="on_button_run_clicked" swapped="no"/>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">4</property>
                      </packing>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Docking</property>
              </object>
            </child>

            <!-- ==================== TAB: Results ==================== -->
            <child>
              <object class="GtkAlignment">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="top-padding">8</property>
                <property name="bottom-padding">8</property>
                <property name="left-padding">8</property>
                <property name="right-padding">8</property>
                <child>
                  <object class="GtkBox">
                    <property name="visible">True</property>
                    <property name="can-focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="vexpand">True</property>
                        <property name="shadow-type">in</property>
                        <child>
                          <object class="GtkTreeView" id="treeview_results">
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="model">liststore_results</property>
                            <child internal-child="selection">
                              <object class="GtkTreeSelection" id="treeview_results_selection">
                                <signal name="changed" handler="on_treeview_results_selection_changed" swapped="no"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_receptor">
                                <property name="title" translatable="yes">Receptor</property>
                                <property name="sort-column-id">0</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">0</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_ligand">
                                <property name="title" translatable="yes">Ligand</property>
                                <property name="sort-column-id">1</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">1</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_run">
                                <property name="title" translatable="yes">Run</property>
                                <property name="sort-column-id">2</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">2</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_energy">
                                <property name="title" translatable="yes">Energy (kcal/mol)</property>
                                <property name="sort-column-id">3</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">3</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_cluster_rank">
                                <property name="title" translatable="yes">Cluster</property>
                                <property name="sort-column-id">4</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">4</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="col_cluster_rmsd">
                                <property name="title" translatable="yes">Cluster RMSD</property>
                                <property name="sort-column-id">5</property>
                                <child>
                                  <object class="GtkCellRendererText"/>
                                  <attributes>
                                    <attribute name="text">5</attribute>
                                  </attributes>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">True</property>
                        <property name="fill">True</property>
                        <property name="position">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButtonBox">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="spacing">5</property>
                        <property name="layout-style">end</property>
                        <child>
                          <object class="GtkButton" id="button_import_previous_results">
                            <property name="label" translatable="yes">Import previous results...</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                            <property name="tooltip-text" translatable="yes">Points at a previous "..._OUTPUTS" folder generated by this tool (or AutoDock Vina's own) and adds every row from its affinity_logs.txt to the table below, alongside whatever is already loaded -- no docking is re-run, the existing *_docked.pdbqt/.dlg files there are reused as-is.</property>
                            <signal name="clicked" handler="on_button_import_previous_results_clicked" swapped="no"/>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">0</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_clear_results">
                            <property name="label" translatable="yes">Clear results</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                            <signal name="clicked" handler="on_button_clear_results_clicked" swapped="no"/>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkButton" id="button_import_pose">
                            <property name="label" translatable="yes">Import all poses</property>
                            <property name="visible">True</property>
                            <property name="can-focus">True</property>
                            <property name="receives-default">True</property>
                            <property name="tooltip-text" translatable="yes">Imports EVERY pose currently in this table (every mode, ligand and receptor) as ONE object with one frame per pose, ranked best affinity first -- including every conformer of an ensemble-docked ligand, not just the selected row's. Once imported, selecting any row jumps the 3D view to that row's own frame. Every pose is checked against the first one's own atom count AND element order before combining -- a count mismatch stops there (kept frames stay); an order-only mismatch (same atoms, different sequence -- an OpenBabel quirk seen across separately-converted conformer files) skips just that one pose, reported afterward, so the rest still combine correctly.</property>
                            <signal name="clicked" handler="on_button_import_pose_clicked" swapped="no"/>
                          </object>
                          <packing>
                            <property name="expand">True</property>
                            <property name="fill">True</property>
                            <property name="position">2</property>
                          </packing>
                        </child>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="fill">True</property>
                        <property name="position">1</property>
                      </packing>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="label" translatable="yes">Results</property>
              </object>
            </child>

          </object>
        </child>
        <child>
          <object class="GtkButtonBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">5</property>
            <property name="layout-style">end</property>
            <child>
              <object class="GtkButton" id="button_close">
                <property name="label" translatable="yes">Close</property>
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="receives-default">True</property>
                <signal name="clicked" handler="close_window" swapped="no"/>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
