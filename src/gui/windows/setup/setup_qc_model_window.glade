                      <object class="GtkEntry" id="entry_pyscf_custom_basis">
                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="tooltip-text" translatable="yes">Overrides the Basis Set dropdown above if non-empty. Any PySCF-valid basis string (case-insensitive, dashes/underscores ignored), e.g. aug-cc-pvtz, cc-pvdz-pp. A different basis per element isn't offered here -- use a script for that.</property>
