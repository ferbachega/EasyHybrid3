                      <packing>
                        <property name="left-attach">0</property>
                        <property name="top-attach">6</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="combobox_pyscf_ecp">
                        <property name="visible">True</property>
                        <property name="can-focus">False</property>
                        <property name="popup-fixed-width">False</property>
                        <property name="tooltip-text" translatable="yes">Effective core potential (relativistic core replacement) for heavy elements. Use an orbital basis meant to go with it (e.g. a def2-* ECP needs a def2-* orbital basis). "None" runs all-electron, PySCF's own default.</property>
                      </object>
                      <packing>
                        <property name="left-attach">1</property>
                        <property name="top-attach">6</property>
                      </packing>
                    </child>
                    <child>
