                        <property name="visible">True</property>
                        <property name="can-focus">True</property>
                        <property name="tooltip-text" translatable="yes">Overrides the Functional dropdown above if non-empty. Any PySCF/libxc functional string (case-insensitive), e.g. wb97x-v, m06-2x, b2plyp -- PySCF accepts many more than the dropdown lists.</property>
                      </object>
                      <packing>
                        <property name="left-attach">1</property>
                        <property name="top-attach">4</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkLabel">
