  <object class="GtkAdjustment" id="adjustment_seed">
    <property name="upper">999999999</property>
    <property name="value">12345</property>
    <property name="step-increment">1</property>
    <property name="page-increment">1000</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_tolerance">
