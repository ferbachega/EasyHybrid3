<?xml version="1.0" encoding="UTF-8"?>
<!-- Search Transition State (Baker eigenvector-following saddle-point
     search, Baker 1986): modeled directly on
     geometry_optimization_window.glade (same Coordinates/Parameters
     frame layout, same log-frequency/max-iterations/rms-tolerance field
     IDs, same SaveTrajectoryBox placeholder box), with the Baker-specific
     fields (Follow Mode, Hessian Updating, Analytic Hessian Frequency)
     added to the same Parameters grid. No "Method" combobox here, unlike
     the geometry optimization window; this tool only ever runs one
     method (Baker). -->
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkAdjustment" id="adjustment_follow_mode">
    <property name="upper">1000</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="adjustment_analytic_frequency">
    <property name="upper">1000</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkWindow" id="transition_state_search_window">
    <property name="can_focus">False</property>
    <signal name="delete-event" handler="close_window" swapped="no"/>
    <signal name="destroy-event" handler="close_window" swapped="no"/>
    <child type="titlebar">
      <placeholder/>
    </child>
    <child>
      <object class="GtkAlignment">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="top_padding">10</property>
        <property name="bottom_padding">10</property>
        <property name="left_padding">10</property>
        <property name="right_padding">10</property>
        <child>
          <object class="GtkBox" id="ts_search_box">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">7</property>
            <child>
              <object class="GtkFrame" id="dftp_setup_box2">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="label_xalign">0.5</property>
                <property name="shadow_type">etched-out</property>
                <child>
                  <object class="GtkAlignment">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="top_padding">10</property>
                    <property name="bottom_padding">10</property>
                    <property name="left_padding">10</property>
                    <property name="right_padding">10</property>
                    <child>
                      <object class="GtkBox" id="box_coordinates">
                        <property name="visible">True</property>
                        <property name="tooltip-text" translatable="yes">Starting structure for the search. It must already be close to the transition state, for example the energy maximum of a PES scan, an NEB/CPR highest point or a hand-built guess. Baker's method refines a nearby saddle point; it does not find a reaction path.</property>
                        <property name="can_focus">False</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <placeholder/>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="label" translatable="yes">Coordinates</property>
                    <property name="tooltip-text" translatable="yes">Starting structure for the search. It must already be close to the transition state, for example the energy maximum of a PES scan, an NEB/CPR highest point or a hand-built guess. Baker's method refines a nearby saddle point; it does not find a reaction path.</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="label" translatable="yes">Method: Baker eigenvector-following (J. Comput. Chem. 7, 385-395, 1986). Refines a structure close to a transition state into a first-order saddle point (exactly one negative Hessian eigenvalue). Check the result with Normal Modes (one imaginary frequency) and follow it downhill with Reaction Path (IRC).</property>
                <property name="wrap">True</property>
                <property name="max-width-chars">56</property>
                <property name="xalign">0</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkFrame" id="dftp_setup_box">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="label_xalign">0.5</property>
                <property name="shadow_type">etched-out</property>
                <child>
                  <object class="GtkAlignment">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="top_padding">10</property>
                    <property name="bottom_padding">10</property>
                    <property name="left_padding">10</property>
                    <property name="right_padding">10</property>
                    <child>
                      <object class="GtkBox" id="ts_search_parm_box">
                        <property name="visible">True</property>
                        <property name="can_focus">False</property>
                        <property name="orientation">vertical</property>
                        <property name="spacing">11</property>
                        <child>
                          <!-- n-columns=2 n-rows=6 -->
                          <object class="GtkGrid">
                            <property name="visible">True</property>
                            <property name="can_focus">False</property>
                            <property name="row_spacing">8</property>
                            <property name="column_spacing">10</property>
                            <property name="column_homogeneous">True</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">Log frequency:</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text" translatable="yes">Write one line to the log every N iterations (energy, RMS gradient, number of negative Hessian eigenvalues). 1 = every iteration.</property>
                              </object>
                              <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_log_frequence">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="text" translatable="yes">1</property>
                                <property name="tooltip-text" translatable="yes">Write one line to the log every N iterations (energy, RMS gradient, number of negative Hessian eigenvalues). 1 = every iteration.</property>
                              </object>
                              <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">0</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">Maximum iterations:</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text" translatable="yes">Maximum number of steps. The cyclohexane example (pDynamo book, Example 11) converges in about 120 steps; 250 is a safe default for small systems. If the limit is reached, the Process Manager reports "Finished (not converged)" and the structure is NOT a transition state.</property>
                              </object>
                              <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">1</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_max_int">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="text" translatable="yes">250</property>
                                <property name="tooltip-text" translatable="yes">Maximum number of steps. The cyclohexane example (pDynamo book, Example 11) converges in about 120 steps; 250 is a safe default for small systems. If the limit is reached, the Process Manager reports "Finished (not converged)" and the structure is NOT a transition state.</property>
                              </object>
                              <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">1</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">RMS Grad. Tolerance:</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text" translatable="yes">Convergence criterion: the search stops when the RMS of the gradient falls below this value (kJ/mol/Å). 0.001 is the value used in the pDynamo example; 0.1 is too loose to locate a saddle point.</property>
                              </object>
                              <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">2</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkEntry" id="entry_rmsd_tol">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="text" translatable="yes">0.001</property>
                                <property name="tooltip-text" translatable="yes">Convergence criterion: the search stops when the RMS of the gradient falls below this value (kJ/mol/Å). 0.001 is the value used in the pDynamo example; 0.1 is too loose to locate a saddle point.</property>
                              </object>
                              <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">2</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">Follow mode:</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text" translatable="yes">Which Hessian mode the search climbs, counted from the lowest eigenvalue (0 = lowest). 0 is right when the starting structure is close to the transition state: there the lowest mode is the reaction coordinate. Use 1, 2, ... when the reaction coordinate is a higher mode, for example when starting from a minimum; after the first step the search keeps following that mode by its overlap with the previous step. Run Normal Modes on the starting structure to see which mode moves the atoms of the reaction.</property>
                              </object>
                              <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">3</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkSpinButton" id="spinbtn_follow_mode">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="adjustment">adjustment_follow_mode</property>
                                <property name="tooltip-text" translatable="yes">Which Hessian mode the search climbs, counted from the lowest eigenvalue (0 = lowest). 0 is right when the starting structure is close to the transition state: there the lowest mode is the reaction coordinate. Use 1, 2, ... when the reaction coordinate is a higher mode, for example when starting from a minimum; after the first step the search keeps following that mode by its overlap with the previous step. Run Normal Modes on the starting structure to see which mode moves the atoms of the reaction.</property>
                              </object>
                              <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">3</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">Hessian updating:</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text" translatable="yes">How the approximate Hessian is updated after each step, without recomputing it.
BOFILL (recommended): designed for saddle points, keeps the negative eigenvalue.
POWELL: also suitable for saddle points, usually a little slower.
BFGS and Murtagh-Sargent are not offered: in tests they either fail to converge or fall back to a minimum.</property>
                              </object>
                              <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">4</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkComboBoxText" id="combobox_hessian_updating">
                                <property name="visible">True</property>
                                <property name="tooltip-text" translatable="yes">How the approximate Hessian is updated after each step, without recomputing it.
BOFILL (recommended): designed for saddle points, keeps the negative eigenvalue.
POWELL: also suitable for saddle points, usually a little slower.
BFGS and Murtagh-Sargent are not offered: in tests they either fail to converge or fall back to a minimum.</property>
                                <property name="can_focus">False</property>
                                <items>
                                  <item translatable="yes" id="BOFILL">BOFILL (recommended)</item>
                                  <item translatable="yes" id="POWELL">POWELL</item>
                                </items>
                                <property name="active">0</property>
                              </object>
                              <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">4</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="visible">True</property>
                                <property name="can_focus">False</property>
                                <property name="label" translatable="yes">Recompute Hessian every:</property>
                                <property name="xalign">1</property>
                                <property name="tooltip-text" translatable="yes">Recompute the exact Hessian every N steps instead of only updating it (0 = never; the Hessian is always computed once at the start). The Hessian is computed by finite differences, which costs 6 gradient evaluations per free atom: cheap with MM or semi-empirical methods, expensive with ab initio or DFT. Fewer steps are needed (cyclohexane: 27 steps with N = 1, 123 with N = 0), so use 1 to 10 when the system is small or the search does not converge.</property>
                              </object>
                              <packing>
                                <property name="left_attach">0</property>
                                <property name="top_attach">5</property>
                              </packing>
                            </child>
                            <child>
                              <object class="GtkSpinButton" id="spinbtn_analytic_frequency">
                                <property name="visible">True</property>
                                <property name="can_focus">True</property>
                                <property name="adjustment">adjustment_analytic_frequency</property>
                                <property name="tooltip-text" translatable="yes">Recompute the exact Hessian every N steps instead of only updating it (0 = never; the Hessian is always computed once at the start). The Hessian is computed by finite differences, which costs 6 gradient evaluations per free atom: cheap with MM or semi-empirical methods, expensive with ab initio or DFT. Fewer steps are needed (cyclohexane: 27 steps with N = 1, 123 with N = 0), so use 1 to 10 when the system is small or the search does not converge.</property>
                              </object>
                              <packing>
                                <property name="left_attach">1</property>
                                <property name="top_attach">5</property>
                              </packing>
                            </child>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">0</property>
                          </packing>
                        </child>
                        <child>
                          <object class="GtkSeparator">
                            <property name="visible">True</property>
                            <property name="can_focus">False</property>
                          </object>
                          <packing>
                            <property name="expand">False</property>
                            <property name="fill">True</property>
                            <property name="position">1</property>
                          </packing>
                        </child>
                        <child>
                          <placeholder/>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="label">
                  <object class="GtkLabel">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="label" translatable="yes">Parameters</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">2</property>
              </packing>
            </child>
            <child>
              <placeholder/>
            </child>
            <child>
              <object class="GtkButtonBox">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="spacing">8</property>
                <property name="layout_style">end</property>
                <child>
                  <placeholder/>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="label" translatable="yes">Cancel</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="receives_default">True</property>
                    <signal name="clicked" handler="close_window" swapped="no"/>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="label" translatable="yes">Run</property>
                    <property name="tooltip-text" translatable="yes">Start the search as a job in the Process Manager. The result is added as a new coordinate set of the active system.</property>
                    <property name="width_request">150</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="receives_default">True</property>
                    <signal name="clicked" handler="run_opt" swapped="no"/>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                    <property name="position">2</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">4</property>
              </packing>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
