<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by hand, following the same GtkBuilder 3.20 conventions
     already used throughout src/gui/windows/**/*.glade in this project
     (mirrors fragment_library_window.glade). -->
<interface>
  <requires lib="gtk+" version="3.20"/>

  <object class="GtkTreeStore" id="structure_treestore">
    <columns>
      <!-- 0: display name (category or structure) -->
      <column type="gchararray"/>
      <!-- 1: file path (empty string for a category row) -->
      <column type="gchararray"/>
    </columns>
  </object>

  <object class="GtkWindow" id="window">
    <property name="can-focus">False</property>
    <property name="title" translatable="yes">Structure Library</property>
    <property name="type-hint">utility</property>
    <property name="default-width">280</property>
    <property name="default-height">360</property>
    <signal name="delete-event" handler="on_close_button_clicked" swapped="no"/>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="border-width">8</property>

        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">Double-click (or select + Use) a structure, then click anywhere in the Builder to place it -- no hydrogen reference needed.</property>
            <property name="wrap">True</property>
            <property name="max-width-chars">32</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="shadow-type">in</property>
            <child>
              <object class="GtkTreeView" id="structure_treeview">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="model">structure_treestore</property>
                <property name="headers-visible">False</property>
                <signal name="row-activated" handler="on_structure_row_activated" swapped="no"/>
                <child internal-child="selection">
                  <object class="GtkTreeSelection">
                    <signal name="changed" handler="on_selection_changed" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="structure_name_column">
                    <property name="title" translatable="yes">Structure</property>
                    <child>
                      <object class="GtkCellRendererText" id="structure_name_renderer"/>
                      <attributes>
                        <attribute name="text">0</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <!-- 3D preview (user's own request): a SEPARATE, disposable
             vismol instance (molecule_preview.MoleculePreview), zoom +
             rotation only. This GtkFrame+GtkBox is just a sized
             placeholder: the actual GL widget is packed into
             preview_box programmatically in Python (open_window()),
             same "placeholder + pack_start() in code" pattern
             gui/main/MainWindow.glade itself uses for the app's main
             3D view. -->
        <child>
          <object class="GtkFrame">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="shadow-type">in</property>
            <child>
              <object class="GtkBox" id="preview_box">
                <property name="visible">True</property>
                <property name="can-focus">False</property>
                <property name="height-request">180</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkLabel" id="status_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">No structure selected.</property>
            <property name="wrap">True</property>
            <property name="max-width-chars">32</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkButtonBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="layout-style">end</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="use_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Use</property>
                <signal name="clicked" handler="on_use_button_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Close</property>
                <signal name="clicked" handler="on_close_button_clicked" swapped="no"/>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

      </object>
    </child>
  </object>
</interface>
