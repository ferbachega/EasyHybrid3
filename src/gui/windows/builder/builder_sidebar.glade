<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by hand, following the same GtkBuilder 3.20 conventions
     already used throughout src/gui/windows/**/*.glade in this project
     (see e.g. setup/import_system_window.glade). -->
<interface>
  <requires lib="gtk+" version="3.20"/>

  <object class="GtkWindow" id="window">
    <property name="can-focus">False</property>
    <property name="title" translatable="yes">Builder</property>
    <property name="type-hint">utility</property>
    <property name="resizable">False</property>
    <signal name="delete-event" handler="on_close_button_clicked" swapped="no"/>
    <child>
      <object class="GtkBox" id="sidebar_root_box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="border-width">10</property>

        <!-- Editing on/off -->
        <child>
          <object class="GtkToggleButton" id="placemode_toggle">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="label" translatable="yes">Editing: OFF</property>
            <property name="active">False</property>
            <signal name="toggled" handler="on_placemode_toggled" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkSeparator">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <!-- Tool selector: two GtkRadioButtons sharing a group, drawn
             WITHOUT the round radio indicator (draw-indicator=False) so
             they look like a normal pair of toggle/segmented buttons
             instead - a common GTK technique for "pick exactly one of
             these" button groups. "group" references the OTHER radio
             button by its id - GtkBuilder resolves that cross-reference
             regardless of where each widget sits in the tree, so nesting
             them normally here (unlike an earlier, broken draft of this
             file that tried to declare them as detached top-level
             objects and never actually packed them into any container -
             fixed before ever being tested against a real GTK build) is
             both correct AND simplest. -->
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">Tool</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="tool_box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="homogeneous">True</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkRadioButton" id="tool_add_radio">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Add</property>
                <property name="draw-indicator">False</property>
                <property name="active">True</property>
                <signal name="toggled" handler="on_tool_changed" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkRadioButton" id="tool_delete_radio">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Delete</property>
                <property name="draw-indicator">False</property>
                <property name="group">tool_add_radio</property>
                <signal name="toggled" handler="on_tool_changed" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkRadioButton" id="tool_move_radio">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Move</property>
                <property name="draw-indicator">False</property>
                <property name="group">tool_add_radio</property>
                <signal name="toggled" handler="on_tool_changed" swapped="no"/>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkSeparator">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <!-- Element selector - same "radio buttons styled as flat
             toggle buttons" technique, own separate group (independent
             from the tool selector above). Only a handful of common
             elements for this first version. -->
        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">Element</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="element_box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="homogeneous">True</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkRadioButton" id="element_C_radio">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">C</property>
                <property name="draw-indicator">False</property>
                <property name="active">True</property>
                <signal name="toggled" handler="on_element_changed" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkRadioButton" id="element_N_radio">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">N</property>
                <property name="draw-indicator">False</property>
                <property name="group">element_C_radio</property>
                <signal name="toggled" handler="on_element_changed" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkRadioButton" id="element_O_radio">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">O</property>
                <property name="draw-indicator">False</property>
                <property name="group">element_C_radio</property>
                <signal name="toggled" handler="on_element_changed" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkRadioButton" id="element_H_radio">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">H</property>
                <property name="draw-indicator">False</property>
                <property name="group">element_C_radio</property>
                <signal name="toggled" handler="on_element_changed" swapped="no"/>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkSeparator">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <!-- Clean up structure -->
        <child>
          <object class="GtkButton" id="clean_up_button">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="label" translatable="yes">Clean Up</property>
            <signal name="clicked" handler="on_clean_up_button_clicked" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <!-- Undo -->
        <child>
          <object class="GtkButton" id="undo_button">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="label" translatable="yes">Undo</property>
            <signal name="clicked" handler="on_undo_button_clicked" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkButton" id="close_button">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="label" translatable="yes">Close</property>
            <signal name="clicked" handler="on_close_button_clicked" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

      </object>
    </child>
  </object>
</interface>
