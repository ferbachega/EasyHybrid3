<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by hand, following the same GtkBuilder 3.20 conventions
     already used throughout src/gui/windows/**/*.glade in this project
     (see e.g. builder/fragment_library_window.glade). -->
<interface>
  <requires lib="gtk+" version="3.20"/>

  <object class="GtkListStore" id="atom_types_liststore">
    <columns>
      <!-- 0: atom_id (int, hidden, row identity) -->
      <column type="gint"/>
      <!-- 1: element symbol -->
      <column type="gchararray"/>
      <!-- 2: atom name -->
      <column type="gchararray"/>
      <!-- 3: effective type (override if set, else perceived), editable -->
      <column type="gchararray"/>
      <!-- 4: status text ("auto" / "manual") -->
      <column type="gchararray"/>
      <!-- 5: tooltip text (valid type labels for this row's element) -->
      <column type="gchararray"/>
      <!-- 6: formal charge (int), editable -->
      <column type="gint"/>
    </columns>
  </object>

  <object class="GtkWindow" id="window">
    <property name="can-focus">False</property>
    <property name="title" translatable="yes">Atom Types</property>
    <property name="type-hint">utility</property>
    <property name="default-width">560</property>
    <property name="default-height">360</property>
    <signal name="delete-event" handler="on_close_button_clicked" swapped="no"/>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="border-width">8</property>

        <child>
          <object class="GtkLabel" id="header_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">Selected atoms</property>
            <property name="wrap">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkScrolledWindow">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="shadow-type">in</property>
            <child>
              <object class="GtkTreeView" id="atom_types_treeview">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="model">atom_types_liststore</property>
                <property name="tooltip-column">5</property>
                <child internal-child="selection">
                  <object class="GtkTreeSelection" id="atom_types_treeview_selection">
                    <property name="mode">multiple</property>
                    <signal name="changed" handler="on_treeview_selection_changed" swapped="no"/>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="atom_id_column">
                    <property name="title" translatable="yes">#</property>
                    <child>
                      <object class="GtkCellRendererText" id="atom_id_renderer"/>
                      <attributes>
                        <attribute name="text">0</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="element_column">
                    <property name="title" translatable="yes">Element</property>
                    <child>
                      <object class="GtkCellRendererText" id="element_renderer"/>
                      <attributes>
                        <attribute name="text">1</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="name_column">
                    <property name="title" translatable="yes">Name</property>
                    <child>
                      <object class="GtkCellRendererText" id="name_renderer"/>
                      <attributes>
                        <attribute name="text">2</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="type_column">
                    <property name="title" translatable="yes">DYFF Type</property>
                    <property name="expand">True</property>
                    <child>
                      <object class="GtkCellRendererText" id="type_renderer">
                        <property name="editable">True</property>
                        <signal name="edited" handler="on_type_cell_edited" swapped="no"/>
                      </object>
                      <attributes>
                        <attribute name="text">3</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="status_column">
                    <property name="title" translatable="yes">Source</property>
                    <child>
                      <object class="GtkCellRendererText" id="status_renderer"/>
                      <attributes>
                        <attribute name="text">4</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="charge_column">
                    <property name="title" translatable="yes">Charge</property>
                    <child>
                      <object class="GtkCellRendererText" id="charge_renderer">
                        <property name="editable">True</property>
                        <property name="xalign">1</property>
                        <signal name="edited" handler="on_charge_cell_edited" swapped="no"/>
                      </object>
                      <attributes>
                        <attribute name="text">6</attribute>
                      </attributes>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkLabel" id="status_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="wrap">True</property>
            <property name="label" translatable="yes">Tip: hover a row to see the valid DYFF type labels for that element.</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkBox" id="button_box">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkButton" id="refresh_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Refresh</property>
                <property name="tooltip-text" translatable="yes">Re-run DYFF's atom typer on the current structure (e.g. after further edits changed bonds).</property>
                <signal name="clicked" handler="on_refresh_button_clicked" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="clear_override_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Clear Override(s)</property>
                <property name="tooltip-text" translatable="yes">Revert the selected row(s) back to the automatically perceived type.</property>
                <signal name="clicked" handler="on_clear_override_button_clicked" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="protonate_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Protonate (+H)</property>
                <property name="tooltip-text" translatable="yes">Adds a hydrogen and +1 formal charge to the selected row(s) -- e.g. a neutral amine nitrogen (3 bonds) becomes a tetravalent ammonium nitrogen (4 bonds, charge +1).</property>
                <signal name="clicked" handler="on_protonate_button_clicked" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="deprotonate_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Deprotonate (-H)</property>
                <property name="tooltip-text" translatable="yes">Removes a hydrogen and -1 formal charge from the selected row(s) -- e.g. a carboxylic acid -OH (2 bonds on O) becomes a carboxylate -O- (1 bond, charge -1).</property>
                <signal name="clicked" handler="on_deprotonate_button_clicked" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Close</property>
                <signal name="clicked" handler="on_close_button_clicked" swapped="no"/>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="pack-type">end</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

      </object>
    </child>
  </object>
</interface>
