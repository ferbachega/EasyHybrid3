<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by hand, following the same GtkBuilder 3.20 conventions
     already used throughout src/gui/windows/**/*.glade in this project
     (mirrors atom_types_window.glade's own window shape and builder_
     sidebar.glade's own GtkScale/GtkAdjustment convention for the
     dihedral-rotation slider). -->
<interface>
  <requires lib="gtk+" version="3.20"/>

  <!-- Translate sliders: +/-5 Angstrom per drag gesture (resets to 0 on
       release -- see transform_selection_window.py's own on_slider_
       released(), same "nudge, don't accumulate on the widget itself"
       convention every axis below shares). -->
  <object class="GtkAdjustment" id="translate_x_adjustment">
    <property name="lower">-5</property>
    <property name="upper">5</property>
    <property name="value">0</property>
    <property name="step-increment">0.01</property>
    <property name="page-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="translate_y_adjustment">
    <property name="lower">-5</property>
    <property name="upper">5</property>
    <property name="value">0</property>
    <property name="step-increment">0.01</property>
    <property name="page-increment">0.5</property>
  </object>
  <object class="GtkAdjustment" id="translate_z_adjustment">
    <property name="lower">-5</property>
    <property name="upper">5</property>
    <property name="value">0</property>
    <property name="step-increment">0.01</property>
    <property name="page-increment">0.5</property>
  </object>

  <!-- Rotate sliders: full +/-180 degree range per drag gesture, around
       the selection's own centroid (see atom_ops.rotate_atoms_around_
       point()'s own docstring), also resetting to 0 on release. -->
  <object class="GtkAdjustment" id="rotate_x_adjustment">
    <property name="lower">-180</property>
    <property name="upper">180</property>
    <property name="value">0</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="rotate_y_adjustment">
    <property name="lower">-180</property>
    <property name="upper">180</property>
    <property name="value">0</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="rotate_z_adjustment">
    <property name="lower">-180</property>
    <property name="upper">180</property>
    <property name="value">0</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>

  <object class="GtkWindow" id="window">
    <property name="can-focus">False</property>
    <property name="title" translatable="yes">Transform Selection</property>
    <property name="type-hint">utility</property>
    <property name="default-width">280</property>
    <signal name="delete-event" handler="on_close_button_clicked" swapped="no"/>
    <child>
      <object class="GtkBox" id="root_box">
        <property name="visible">True</property>
        <property name="can-focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="border-width">8</property>

        <child>
          <object class="GtkLabel" id="header_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">0 atom(s) selected</property>
            <property name="wrap">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">Translate (A)</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkScale" id="translate_x_scale">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="sensitive">False</property>
            <property name="adjustment">translate_x_adjustment</property>
            <property name="digits">2</property>
            <property name="draw-value">True</property>
            <property name="value-pos">right</property>
            <signal name="value-changed" handler="on_translate_x_changed" swapped="no"/>
            <signal name="button-release-event" handler="on_slider_released" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkScale" id="translate_y_scale">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="sensitive">False</property>
            <property name="adjustment">translate_y_adjustment</property>
            <property name="digits">2</property>
            <property name="draw-value">True</property>
            <property name="value-pos">right</property>
            <signal name="value-changed" handler="on_translate_y_changed" swapped="no"/>
            <signal name="button-release-event" handler="on_slider_released" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkScale" id="translate_z_scale">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="sensitive">False</property>
            <property name="adjustment">translate_z_adjustment</property>
            <property name="digits">2</property>
            <property name="draw-value">True</property>
            <property name="value-pos">right</property>
            <signal name="value-changed" handler="on_translate_z_changed" swapped="no"/>
            <signal name="button-release-event" handler="on_slider_released" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkSeparator">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkLabel">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes">Rotate (deg, around selection centroid)</property>
            <property name="wrap">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkScale" id="rotate_x_scale">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="sensitive">False</property>
            <property name="adjustment">rotate_x_adjustment</property>
            <property name="digits">0</property>
            <property name="draw-value">True</property>
            <property name="value-pos">right</property>
            <signal name="value-changed" handler="on_rotate_x_changed" swapped="no"/>
            <signal name="button-release-event" handler="on_slider_released" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkScale" id="rotate_y_scale">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="sensitive">False</property>
            <property name="adjustment">rotate_y_adjustment</property>
            <property name="digits">0</property>
            <property name="draw-value">True</property>
            <property name="value-pos">right</property>
            <signal name="value-changed" handler="on_rotate_y_changed" swapped="no"/>
            <signal name="button-release-event" handler="on_slider_released" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkScale" id="rotate_z_scale">
            <property name="visible">True</property>
            <property name="can-focus">True</property>
            <property name="sensitive">False</property>
            <property name="adjustment">rotate_z_adjustment</property>
            <property name="digits">0</property>
            <property name="draw-value">True</property>
            <property name="value-pos">right</property>
            <signal name="value-changed" handler="on_rotate_z_changed" swapped="no"/>
            <signal name="button-release-event" handler="on_slider_released" swapped="no"/>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkLabel" id="status_label">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="halign">start</property>
            <property name="label" translatable="yes"></property>
            <property name="wrap">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

        <child>
          <object class="GtkButtonBox">
            <property name="visible">True</property>
            <property name="can-focus">False</property>
            <property name="layout-style">end</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="refresh_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Refresh</property>
                <signal name="clicked" handler="on_refresh_button_clicked" swapped="no"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="close_button">
                <property name="visible">True</property>
                <property name="can-focus">True</property>
                <property name="label" translatable="yes">Close</property>
                <signal name="clicked" handler="on_close_button_clicked" swapped="no"/>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
          </packing>
        </child>

      </object>
    </child>
  </object>
</interface>
