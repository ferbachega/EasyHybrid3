# NAMD input for valacyclovir (EasyHybrid DYFF -> CHARMM format, dyff_eh_to_namd.py)
structure          valacyclovir.psf
coordinates        valacyclovir.pdb
paraTypeCharmm     on
parameters         valacyclovir.prm

# . DYFF specific: geometric combining of sigma (and epsilon), 1-4 electrostatics
vdwGeometricSigma  yes
exclude            scaled1-4
1-4scaling         0.5000   ;# NAMD 3 also accepts the newer name oneFourScaling

temperature        300
cutoff             999.0
pairlistdist       1001.0
switching          off

outputName         valacyclovir_minimize
binaryOutput       no
outputEnergies     100

minimize 1000
